+    /// Where the next token ends if it is `RD` or `-|`, which mark a
+    /// binary blob. Found by looking at the bytes only: tokenizing ahead
+    /// would recurse into a procedure that follows, and each number in it
+    /// would look ahead in turn, which takes time exponential in the
+    /// unclosed procedures of a broken font.
+    fn binary_marker_end(&self) -> Option<usize> {
+        let mut pos = self.pos;
+        loop {
+            while is_whitespace(*self.data.get(pos)?) {
+                pos += 1;
+            }
+            if self.data.get(pos) != Some(&b'%') {
+                break;
+            }
+            while let Some(&c) = self.data.get(pos) {
+                pos += 1;
+                if c == b'\n' || c == b'\r' {
+                    break;
+                }
+            }
+        }
+        let rest = self.data.get(pos..)?;
+        let len = rest
+            .iter()
+            .position(|&c| is_special_or_whitespace(c))
+            .unwrap_or(rest.len());
+        matches!(&rest[..len], b"RD" | b"-|").then_some(pos + len)
+    }
+
     fn peek(&self) -> Option<Token<'a>> {
         self.clone().next()
     }
